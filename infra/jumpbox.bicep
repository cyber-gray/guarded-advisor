// Windows jumpbox inside the lab VNet (w1-jump, D-004, D-018). Guarded Advisor template, deployed ONCE.
// The per-session Bastion is infra/bastion.bicep; the subnets are in main.bicep (vnet.bicep defines them inline).
//
// - Windows, because the Foundry portal needs a browser inside the VNet. Windows Server 2025 Datacenter Azure
//   Edition with Desktop Experience: Entra RDP through Bastion needs Windows Server 2022 or later, or Windows 11
//   21H2 or later (https://learn.microsoft.com/azure/bastion/bastion-entra-id-authentication, updated 2026-08-11).
// - No public IP. Reached only through Bastion Basic with Microsoft Entra ID sign-in (portal, public preview).
// - Trusted launch with Secure Boot and vTPM, set explicitly: below Compute API 2025-11-01 a VM without
//   securityProfile isn't trusted launch (https://learn.microsoft.com/azure/virtual-machines/trusted-launch,
//   updated 2026-09-26). B-family and Windows Server 2025 are supported. Guest Attestation reports boot integrity
//   to Defender for Cloud (https://learn.microsoft.com/azure/virtual-machines/boot-integrity-monitoring-overview).
// - Entra sign-in: system-assigned identity before the AADLoginForWindows extension; Virtual Machine Administrator
//   Login grants sign-in (Owner doesn't); Reader on the VM and its NIC are the other documented prerequisites. The
//   VM becomes Entra joined, which creates a device object in the tenant (delete it in w3-teardown).
//   https://learn.microsoft.com/entra/identity/devices/howto-vm-sign-in-azure-ad-windows
// - Local admin password: generated by ARM at deploy time from newGuid() and never passed, printed, logged or
//   stored; secure parameters aren't kept in deployment history. Nobody knows it, and it's never used: sign-in is
//   Entra only, and recovery is the portal's Reset password, done by Tooni. Redeploying this template generates a
//   new value, so it isn't part of the session routine (scripts/jumpbox.sh create is for a rebuild only).
// - OS disk export: networkAccessPolicy DenyAll and publicNetworkAccess Disabled can't be set here, because the
//   VM's osDisk doesn't carry them (only Microsoft.Compute/disks does). scripts/jumpbox.sh harden-disk applies them
//   after the deploy; docs/runbook.md (2026-10-16) explains why, and scripts/verify.sh disks checks for drift.
// - Auto-shutdown uses Microsoft.DevTestLab/schedules, which needs the Microsoft.DevTestLab resource provider.

@description('Azure region')
param location string

@description('VM name; also the Windows computer name and the Entra device name (15 characters or fewer)')
@maxLength(15)
param vmName string = 'ga-jump-lab'

@description('VM size; B2s per docs/cost-estimate.md')
param vmSize string = 'Standard_B2s'

@description('Existing VNet and jumpbox subnet from main.bicep')
param vnetName string = 'ga-vnet-lab'
param subnetName string = 'jumpbox-subnet'

@description('Local administrator name (never used for sign-in)')
param adminUsername string = 'gajumpadmin'

@description('Local administrator password, generated at deploy time; never pass this parameter')
@secure()
param adminPassword string = '${toUpper(newGuid())}${newGuid()}'

@description('Object ID of the person who signs in (Virtual Machine Administrator Login, Reader); passed at deploy time')
param adminObjectId string

@description('Create the daily auto-shutdown schedule (needs the Microsoft.DevTestLab provider)')
param enableAutoShutdown bool = true

@description('Auto-shutdown time, HHmm')
param autoShutdownTime string = '2200'

@description('Auto-shutdown time zone (Windows time zone ID)')
param autoShutdownTimeZone string = 'Eastern Standard Time'

@description('Tags applied to every resource this template creates')
param tags object = {}

var roleIds = {
  vmAdminLogin: '1c0163c0-47e6-4577-8991-ea5c82e286e4' // Virtual Machine Administrator Login
  reader: 'acdd72a7-3385-48ef-bd42-f606fba81ae7' // Reader
}

resource vnet 'Microsoft.Network/virtualNetworks@2024-05-01' existing = {
  name: vnetName
}

resource subnet 'Microsoft.Network/virtualNetworks/subnets@2024-05-01' existing = {
  parent: vnet
  name: subnetName
}

resource nic 'Microsoft.Network/networkInterfaces@2024-05-01' = {
  name: '${vmName}-nic'
  location: location
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          privateIPAllocationMethod: 'Dynamic'
          subnet: {
            id: subnet.id
          }
        }
      }
    ]
  }
}

resource vm 'Microsoft.Compute/virtualMachines@2025-04-01' = {
  name: vmName
  location: location
  tags: tags
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    hardwareProfile: {
      vmSize: vmSize
    }
    securityProfile: {
      securityType: 'TrustedLaunch'
      uefiSettings: {
        secureBootEnabled: true
        vTpmEnabled: true
      }
    }
    osProfile: {
      computerName: vmName
      adminUsername: adminUsername
      adminPassword: adminPassword
      windowsConfiguration: {
        provisionVMAgent: true
        enableAutomaticUpdates: true
        patchSettings: {
          patchMode: 'AutomaticByPlatform'
        }
      }
    }
    storageProfile: {
      imageReference: {
        publisher: 'MicrosoftWindowsServer'
        offer: 'WindowsServer'
        sku: '2025-datacenter-azure-edition'
        version: 'latest'
      }
      osDisk: {
        name: '${vmName}-osdisk'
        createOption: 'FromImage'
        caching: 'ReadWrite'
        deleteOption: 'Delete'
        managedDisk: {
          storageAccountType: 'StandardSSD_LRS'
        }
      }
    }
    networkProfile: {
      networkInterfaces: [
        {
          id: nic.id
          properties: {
            deleteOption: 'Delete'
          }
        }
      ]
    }
    diagnosticsProfile: {
      bootDiagnostics: {
        enabled: true // managed storage: no storage account to secure
      }
    }
  }
}

resource aadLogin 'Microsoft.Compute/virtualMachines/extensions@2025-04-01' = {
  parent: vm
  name: 'AADLoginForWindows'
  location: location
  tags: tags
  properties: {
    publisher: 'Microsoft.Azure.ActiveDirectory'
    type: 'AADLoginForWindows'
    typeHandlerVersion: '2.2' // latest in canadaeast on 2026-10-16 (az vm extension image list)
    autoUpgradeMinorVersion: true
  }
}

resource guestAttestation 'Microsoft.Compute/virtualMachines/extensions@2025-04-01' = {
  parent: vm
  name: 'GuestAttestation'
  location: location
  tags: tags
  dependsOn: [
    aadLogin // one extension operation at a time
  ]
  properties: {
    publisher: 'Microsoft.Azure.Security.WindowsAttestation'
    type: 'GuestAttestation'
    typeHandlerVersion: '1.0'
    autoUpgradeMinorVersion: true
    enableAutomaticUpgrade: true
    settings: {
      AttestationConfig: {
        MaaSettings: {
          maaEndpoint: ''
          maaTenantName: 'GuestAttestation'
        }
        AscSettings: {
          ascReportingEndpoint: ''
          ascReportingFrequency: ''
        }
        useCustomToken: 'false'
        disableAlerts: 'false'
      }
    }
  }
}

resource autoShutdown 'Microsoft.DevTestLab/schedules@2018-09-15' = if (enableAutoShutdown) {
  name: 'shutdown-computevm-${vmName}'
  location: location
  tags: tags
  properties: {
    status: 'Enabled'
    taskType: 'ComputeVmShutdownTask'
    dailyRecurrence: {
      time: autoShutdownTime
    }
    timeZoneId: autoShutdownTimeZone
    targetResourceId: vm.id
    notificationSettings: {
      status: 'Disabled'
    }
  }
}

resource vmAdminLogin 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: vm
  name: guid(vm.id, adminObjectId, roleIds.vmAdminLogin)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roleIds.vmAdminLogin)
    principalId: adminObjectId
    principalType: 'User'
    description: 'Entra RDP sign-in to the jumpbox through Bastion (w1-jump, D-018)'
  }
}

resource vmReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: vm
  name: guid(vm.id, adminObjectId, roleIds.reader)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roleIds.reader)
    principalId: adminObjectId
    principalType: 'User'
    description: 'Bastion Entra sign-in prerequisite: Reader on the VM (w1-jump, D-018)'
  }
}

resource nicReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: nic
  name: guid(nic.id, adminObjectId, roleIds.reader)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roleIds.reader)
    principalId: adminObjectId
    principalType: 'User'
    description: 'Bastion Entra sign-in prerequisite: Reader on the VM NIC (w1-jump, D-018)'
  }
}

output vmName string = vm.name
output vmId string = vm.id
output osDiskName string = vm.properties.storageProfile.osDisk.name
output privateIp string = nic.properties.ipConfigurations[0].properties.privateIPAddress
